#!/bin/bash
#

BASE_JOGO=/content/Milhao_3
ROOT=/content
WAV2ADPCM=$ROOT/wav2adpcm

if [ ! -d show-do-milhao-vol3-dc-publico ]; then
	git clone https://github.com/Colgaton/show-do-milhao-vol3-dc-publico.git
fi
if [ -d $ROOT/cd_root ]; then
	rm -rf $ROOT/cd_root
fi

mkdir -p cd_root/{bg,perguntas,sfx,sng,videos}
chmod +x ferramentas/converte_imagem.sh

if [ ! -f showdomilhaovol3.zip ]; then
        echo ""
	echo ** FALTA SHOWDOMILHAOVOL3.ZIP **
        echo ""
	exit 1
fi
unzip showdomilhaovol3.zip -d $BASE_JOGO

# Converte os arquivos para lowercase
cd $BASE_JOGO/img
for f in *; do
    [ -f "$f" ] || continue
    lower=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    [ "$f" = "$lower" ] || mv -- "$f" "$lower"
done
cd $BASE_JOGO/audios
for f in *; do
    [ -f "$f" ] || continue
    lower=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    [ "$f" = "$lower" ] || mv -- "$f" "$lower"
done
cd $BASE_JOGO/videos
for f in *; do
    [ -f "$f" ] || continue
    lower=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    [ "$f" = "$lower" ] || mv -- "$f" "$lower"
done
cd $ROOT
##

# Converte as placas de fases
ls "$BASE_JOGO/img/" | grep -E '^[0-9]+\.jpg$' | while read -r file; do
    output="spr_${file%.jpg}.png"
    bash ferramentas/converte_imagem.sh \
        "$BASE_JOGO/img/$file" \
        "$ROOT/cd_root/shm/$output" \
        256x512
done

# Converte placas de ajuda
convert $BASE_JOGO/img/as.jpg -crop 181x133+6+5 -resize 128x128! +repage $ROOT/cd_root/shm/spr_as.png
convert $BASE_JOGO/img/tres.jpg  -crop 178x133+6+5 -resize 128x128! +repage $ROOT/cd_root/shm/spr_3.png
convert $BASE_JOGO/img/dois.jpg  -crop 178x133+6+5 -resize 128x128! +repage $ROOT/cd_root/shm/spr_2.png
convert $BASE_JOGO/img/rei.jpg  -crop 178x133+6+5 -resize 128x128! +repage $ROOT/cd_root/shm/spr_rei.png
# Converte a placa 4cartas e faz o fundo transparente
convert $BASE_JOGO/img/4cartas.jpg -crop 218x148+4+2 -resize 128x128! +repage $ROOT/cd_root/shm/spr_4cartas_temp.png
convert $ROOT/cd_root/shm/spr_4cartas_temp.png -bordercolor '#d8eb42' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#fce37c' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#e8b13a' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#bbdb4c' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 $ROOT/cd_root/shm/spr_4cartas.png
rm -f $ROOT/cd_root/shm/spr_4cartas_temp.png
ferramentas/converte_imagem.sh $BASE_JOGO/img/ajuda0.jpg $ROOT/cd_root/shm/spr_ajuda0.png 64x64!
ferramentas/converte_imagem.sh $BASE_JOGO/img/ajuda1.jpg $ROOT/cd_root/shm/spr_ajuda1.png 64x64!
ferramentas/converte_imagem.sh $BASE_JOGO/img/ajuda2.jpg $ROOT/cd_root/shm/spr_ajuda2.png 64x64!
ferramentas/converte_imagem.sh $BASE_JOGO/img/ajuda3.jpg $ROOT/cd_root/shm/spr_ajuda3.png 64x64!
ferramentas/converte_imagem.sh $BASE_JOGO/img/ajuda4.jpg $ROOT/cd_root/shm/spr_ajuda4.png 64x64!
ferramentas/converte_imagem.sh $BASE_JOGO/img/ajuda5.jpg $ROOT/cd_root/shm/spr_ajuda5.png 64x64!
# Converte fundo e coloca letras para tela de digitar nome
ferramentas/converte_imagem.sh $BASE_JOGO/img/fundo_pl.jpg /tmp/fundo_pl.jpg 512x512!
convert /tmp/fundo_pl.jpg $ROOT/cd_root/shm/letras.jpg -geometry +117x177 -composite $ROOT/cd_root/bg/bg_digite_nome4.jpg

# Converte ouroX.jpg, mas esse e'um hack: cola ele na image de fundo, converte para a resolucao certa, entao recorta e salva
for ouro in {1..16}; do
 convert $BASE_JOGO/img/telajogo.jpg $BASE_JOGO/img/ouro$ouro.jpg -geometry +347+0 -composite /tmp/temp1.jpg
 convert /tmp/temp1.jpg -filter Lanczos -resize 512x512! -colorspace sRGB -strip -sampling-factor 4:4:4 -quality 85 /tmp/temp2.png
 convert /tmp/temp2.png -crop 256x128+256+0 +repage $ROOT/cd_root/shm/spr_ouro$ouro.png
 rm -f /tmp/temp1.png /tmp/temp2.png
done
# Converte para png e faz o fundo transparente
ferramentas/converte_imagem.sh $BASE_JOGO/img/placas.jpg /tmp/temp1.png 128x128!
convert /tmp/temp1.png -bordercolor '#d8eb42' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#fce37c' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#e8b13a' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#bbdb4c' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#d8f0cc' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#ced9b9' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 $ROOT/cd_root/shm/spr_placas.png
rm -f /tmp/temp1.png
#
ferramentas/converte_imagem.sh $BASE_JOGO/img/quadajud.jpg $ROOT/cd_root/shm/spr_quadroajuda.png 256x256!
# Converte para png e faz o fundo transparente
ferramentas/converte_imagem.sh $BASE_JOGO/img/convid.jpg /tmp/temp1.png 128x128!
convert /tmp/temp1.png -bordercolor '#d8eb42' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#fce37c' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#e8b13a' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#bbdb4c' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#d8f0cc' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 \
	-bordercolor '#ced9b9' -border 1 -fuzz 10% -fill none -draw 'matte 0,0 floodfill' -shave 1x1 $ROOT/cd_root/shm/spr_convid.png

# Backgrounds
ferramentas/converte_imagem.sh $BASE_JOGO/img/telajogo.jpg $ROOT/cd_root/bg/bg_telajogo.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/qjogar.jpg $ROOT/cd_root/bg/bg_qjogar.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/regra_0.jpg $ROOT/cd_root/bg/bg_regra_0.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/regra_1.jpg $ROOT/cd_root/bg/bg_regra_1.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/regra_2.jpg $ROOT/cd_root/bg/bg_regra_2.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/regra_3.jpg $ROOT/cd_root/bg/bg_regra_3.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/telassun.jpg $ROOT/cd_root/bg/bg_telassun.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/tl_placa.jpg $ROOT/cd_root/bg/bg_tl_placa.jpg 512x512!
ferramentas/converte_imagem.sh $BASE_JOGO/img/tl_valor.jpg $ROOT/cd_root/bg/bg_tl_valor.jpg 512x512!
ls $BASE_JOGO/img/p[0-9]*.jpg | while read file; do ferramentas/converte_imagem.sh $file $ROOT/cd_root/bg/bg_$(basename $file) 512x512! ; done

# Sons
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/correta.wav -ac 1 -c:a pcm_s16le /tmp/correta.wav
$WAV2ADPCM -t /tmp/correta.wav $ROOT/cd_root/sfx/sfx_correta.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/certeza1.wav -ac 1 -c:a pcm_s16le /tmp/certeza1.wav
$WAV2ADPCM -t /tmp/certeza1.wav $ROOT/cd_root/sfx/sfx_certeza1.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/certeza2.wav -ac 1 -c:a pcm_s16le /tmp/certeza2.wav
$WAV2ADPCM -t /tmp/certeza2.wav $ROOT/cd_root/sfx/sfx_certeza2.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/certeza3.wav -ac 1 -c:a pcm_s16le /tmp/certeza3.wav
$WAV2ADPCM -t /tmp/certeza3.wav $ROOT/cd_root/sfx/sfx_certeza3.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/clique2.wav -ac 1 -c:a pcm_s16le /tmp/clique2.wav
$WAV2ADPCM -t /tmp/clique2.wav $ROOT/cd_root/sfx/sfx_clique2.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/nome.wav -ac 1 -c:a pcm_s16le /tmp/nome.wav
$WAV2ADPCM -t /tmp/nome.wav $ROOT/cd_root/sfx/sfx_nome.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/entendeu.wav -ac 1 -c:a pcm_s16le /tmp/entendeu.wav
$WAV2ADPCM -t /tmp/entendeu.wav $ROOT/cd_root/sfx/sfx_entendeu.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/quale.wav -ac 1 -c:a pcm_s16le /tmp/quale.wav
$WAV2ADPCM -t /tmp/quale.wav $ROOT/cd_root/sfx/sfx_quale.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/errada.wav -ac 1 -c:a pcm_s16le /tmp/errada.wav
$WAV2ADPCM -t /tmp/errada.wav $ROOT/cd_root/sfx/sfx_errada.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/tempo.wav -ac 1 -c:a pcm_s16le /tmp/tempo.wav
$WAV2ADPCM -t /tmp/tempo.wav $ROOT/cd_root/sfx/sfx_tempo.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/sons/valor.wav -ac 1 -c:a pcm_s16le /tmp/valor.wav
$WAV2ADPCM -t /tmp/valor.wav $ROOT/cd_root/sfx/sfx_valor.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/ouro.wav -ac 1 -c:a pcm_s16le /tmp/ouro.wav
$WAV2ADPCM -t /tmp/ouro.wav $ROOT/cd_root/sfx/sfx_ouro.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/ajuda1.wav -ac 1 -c:a pcm_s16le /tmp/ajuda1.wav
$WAV2ADPCM -t /tmp/ajuda1.wav $ROOT/cd_root/sfx/sfx_ajuda1.wav
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/boasorte.wav -ac 1 -c:a pcm_s16le /tmp/boasorte.wav
$WAV2ADPCM -t /tmp/boasorte.wav $ROOT/cd_root/sfx/sfx_boasorte.wav

# Audios antes de cada fase
for wav in `ls $BASE_JOGO/audios/[1-9]*.wav`; do opus=$(basename $wav | sed s/\.wav/\.opus/g);  opusenc --bitrate 48 $wav $ROOT/cd_root/sng/sng_$opus; done
# outros audios
for wav in entregar.wav susp1.wav susp2.wav susp3.wav susp4.wav susp5.wav susp6.wav; do opus=$(basename $wav | sed s/\.wav/\.opus/g);  opusenc --bitrate 48 $BASE_JOGO/audios/$wav $ROOT/cd_root/sng/sng_$opus; done
# Aumenta o volume do tema antes de converter
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/tema.wav -af "loudnorm=I=-17.5:TP=-1:LRA=7" /tmp/tema.wav
opusenc --bitrate 48 /tmp/tema.wav $ROOT/cd_root/sng/sng_tema.opus

# Convidados devem ser dividos em 2
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/convida.wav -ac 1 -c:a pcm_s16le /tmp/temp0.wav
ffmpeg -hide_banner -y -i /tmp/temp0.wav -t 2.5 /tmp/temp1.wav
ffmpeg -hide_banner -y -i /tmp/temp0.wav -ss 2.7 /tmp/temp2.wav
$WAV2ADPCM -t /tmp/temp1.wav $ROOT/cd_root/sfx/sfx_convida.wav
$WAV2ADPCM -t /tmp/temp2.wav $ROOT/cd_root/sfx/sfx_conversa.wav
rm -f /tmp/temp*.wav
# Colegas deve ser cortado
ffmpeg -hide_banner -y -i $BASE_JOGO/audios/colegas.wav -ac 1 -c:a pcm_s16le /tmp/temp1.wav
ffmpeg -hide_banner -y -i /tmp/temp1.wav -t 2.8 /tmp/temp2.wav
$WAV2ADPCM -t /tmp/temp2.wav $ROOT/cd_root/sfx/sfx_colegas.wav
rm -f /tmp/temp*.wav

# Videos
# Com padding
ffmpeg -hide_banner -y -hide_banner -loglevel error -y -i $BASE_JOGO/videos/abertura.avi -vf "hqdn3d=1.0:1.0:3:3,scale=160:120:flags=lanczos,unsharp=5:5:0.4:3:3:0.15,pad=320:240:80:60:black,fps=20" -b:v 742k -minrate 742k -maxrate 742k -bufsize 742k -ac 1 -ar 32000 -c:a mp2 -b:a 64k -f mpeg $ROOT/cd_root/videos/abertura.mpg
ffmpeg -hide_banner -y -hide_banner -loglevel error -y -i $BASE_JOGO/videos/encerra.avi -vf "hqdn3d=1.0:1.0:3:3,scale=160:120:flags=lanczos,unsharp=5:5:0.4:3:3:0.15,pad=320:240:80:60:black,fps=20" -b:v 742k -minrate 742k -maxrate 742k -bufsize 742k -ac 1 -ar 32000 -c:a mp2 -b:a 64k -f mpeg $ROOT/cd_root/videos/encerra.mpg

# Questoes
mkdir ocx perguntas
cp $BASE_JOGO/*movies*.ocx ocx/
python3 ferramentas/quiz_text_hunt.py ocx --out perguntas
python3 ferramentas/limpar.py perguntas/QUESTOES.csv todas
python3 ferramentas/limpar.py perguntas/QUESTOES_1.csv historia
python3 ferramentas/limpar.py perguntas/QUESTOES_3.csv matematica
python3 ferramentas/limpar.py perguntas/QUESTOES_4.csv ingles
python3 ferramentas/limpar.py perguntas/QUESTOES_5.csv ciencias
python3 ferramentas/limpar.py perguntas/QUESTOES_6.csv geografia
python3 ferramentas/limpar.py perguntas/QUESTOES_7.csv portugues

for topico in todas portugues matematica ingles historia geografia ciencias; do
  for tipo in a b c d; do
	./converter ${topico}_${tipo}.txt $ROOT/cd_root/perguntas/${topico}_${tipo}.dat
  done
done
